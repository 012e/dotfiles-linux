	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential
[user]
	email = huyphmnhat@gmail.com
	name = 012e
[core]
	pager = delta
	autocrlf = input
	protectNTFS = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	syntax-theme = Catppuccin Mocha
	side-by-side = false

[merge]
	conflictStyle = zdiff3

[alias]
	fixc = commit --ammend
	lastc = log -1 HEAD --stat
	searchc = !git rev-list --all | xargs git grep -F
	s = status --short
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	c = commit
	d = diff
	clean-branches = !git for-each-ref --format '%(if:equals=gone)%(upstream:track,nobracket)%(then)%(refname:short)%(end)' refs/heads/ | xargs git branch -D
[color]
	ui = auto
[fetch]
	prune = true
[submodule]
	recurse = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[rerere]
	enabled = true
[diff]
	submodule = log
[push]
	recurseSubmodules = on-demand
	autoSetupRemote = true
[rebase]
	autoStash = true
